@page "/diagnostics"
@inject HttpClient Http

<div class="card-surface">
    <h3>Diagnostics</h3>
    <p class="muted">Run quick checks to diagnose connectivity and API issues.</p>
    <div class="mb-3">
        <button class="btn btn-primary me-2" @onclick="RunHealth">Check /health</button>
        <button class="btn btn-secondary me-2" @onclick="RunApi">Check API</button>
        <button class="btn btn-warning" @onclick="RunSignalR">SignalR negotiate</button>
    </div>
    <div style="background:#0b0b0b;color:#eaeaea;padding:12px;border-radius:6px;min-height:120px;">
        @if (output==null)
        {
            <div class="muted">No diagnostics run yet.</div>
        }
        else
        {
            @foreach(var l in output)
            {
                <div>@l</div>
            }
        }
    </div>
</div>

@code{
    List<string>? output;

    async Task RunHealth()
    {
        output ??= new List<string>();
        output.Insert(0, $"[{DateTime.Now:HH:mm:ss}] Running /health...");
        try { var r=await Http.GetAsync("/health"); output.Insert(0,$"/health -> {(int)r.StatusCode}"); }
        catch(Exception ex){ output.Insert(0,$"/health error: {ex.Message}"); }
    }

    async Task RunApi()
    {
        output ??= new List<string>();
        output.Insert(0,$"[{DateTime.Now:HH:mm:ss}] GET /api/services/running");
        try{ var r=await Http.GetAsync("/api/services/running"); output.Insert(0,$"/api -> {(int)r.StatusCode}"); }
        catch(Exception ex){ output.Insert(0,$"api error: {ex.Message}"); }
    }

    async Task RunSignalR()
    {
        output ??= new List<string>();
        output.Insert(0,$"[{DateTime.Now:HH:mm:ss}] GET /hubs/monitoring/negotiate");
        try{ var r=await Http.GetAsync("/hubs/monitoring/negotiate"); output.Insert(0,$"negotiate -> {(int)r.StatusCode}"); }
        catch(Exception ex){ output.Insert(0,$"negotiate error: {ex.Message}"); }
    }
}
