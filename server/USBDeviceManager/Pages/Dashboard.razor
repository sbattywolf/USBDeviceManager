@page "/dashboard"
@inject NavigationManager Nav

<div class="container-fluid">
    <div class="row g-3">
        <div class="col-12">
            <div class="card-surface">
                <h2>Dashboard</h2>
                <p class="muted">Overview and quick actions.</p>
                <div class="row">
                    <div class="col-md-3">
                        <div class="card-surface">
                            <div class="muted">Server</div>
                            <div class="kpi">Listening</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card-surface">
                            <div class="muted">Agents</div>
                            <div class="kpi">1</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card-surface">
                            <div class="muted">Devices</div>
                            <div class="kpi">12</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card-surface">
                            <div class="muted">Processes</div>
                            <div class="kpi">3</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
