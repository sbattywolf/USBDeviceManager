@using USBDeviceManager.Services
@inject DashboardClient Client

<div class="card">
  <div class="card-header"><strong>Agent Controls</strong></div>
  <div class="card-body">
    <div class="mb-2">
      <label class="form-label">Agent Mode</label>
      <select class="form-select" @onchange="OnModeChanged" value="@selectedMode">
        <option value="External">External (agents connect to this server)</option>
        <option value="Embedded">Embedded (server may start an agent process)</option>
        <option value="Disabled">Disabled</option>
      </select>
    </div>

    <div class="mb-2">
      <label class="form-label">Agent Port</label>
      <input type="number" class="form-control" @bind="agentPort" />
    </div>

    <div class="d-flex gap-2">
      <button class="btn btn-primary" @onclick="StartAgent" disabled="@(!canStart)">Start Agent</button>
      <button class="btn btn-danger" @onclick="StopAgent" disabled="@(!canStop)">Stop Agent</button>
      <button class="btn btn-secondary" @onclick="SaveConfig">Save</button>
    </div>

    <div class="mt-3">
      <small>Running processes:</small>
      <pre>@runningJson</pre>
    </div>
  </div>
</div>

@code {
    private string selectedMode = "External";
    private int agentPort = 5001;
    private bool canStart = true;
    private bool canStop = false;
    private string runningJson = "{}";

    protected override async Task OnInitializedAsync()
    {
        await LoadConfig();
        await RefreshRunning();
    }

    private async Task LoadConfig()
    {
        var cfg = await Client.GetServiceConfigAsync();
        if (cfg != null)
        {
            selectedMode = cfg.AgentMode ?? "External";
            agentPort = cfg.AgentPort;
        }
    }

    private async Task RefreshRunning()
    {
        var running = await Client.GetRunningProcessesAsync();
        runningJson = System.Text.Json.JsonSerializer.Serialize(running ?? new Dictionary<string,int>());
        canStop = running != null && running.ContainsKey("agent");
        canStart = !canStop && selectedMode == "Embedded";
        StateHasChanged();
    }

    private Task OnModeChanged(ChangeEventArgs e)
    {
        selectedMode = e?.Value?.ToString() ?? "External";
        canStart = selectedMode == "Embedded";
        return Task.CompletedTask;
    }

    private async Task StartAgent()
    {
        try
        {
            var res = await Client.StartAgentAsync(agentPort);
            if (res.IsSuccessStatusCode)
            {
                await RefreshRunning();
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                Console.WriteLine($"StartAgent failed: {res.StatusCode} {body}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"StartAgent exception: {ex.Message}");
        }
    }

    private async Task StopAgent()
    {
        try
        {
            var res = await Client.StopServiceAsync("agent");
            if (res.IsSuccessStatusCode)
            {
                await RefreshRunning();
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                Console.WriteLine($"StopAgent failed: {res.StatusCode} {body}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"StopAgent exception: {ex.Message}");
        }
    }

    private async Task SaveConfig()
    {
        var cfg = new USBDeviceManager.Services.ServiceConfig { AgentPort = agentPort, ServerPort = 5000, AgentMode = selectedMode };
        var res = await Client.SaveServiceConfigAsync(cfg);
        if (res.IsSuccessStatusCode)
        {
            await LoadConfig();
        }
    }
}
