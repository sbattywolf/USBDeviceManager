{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=:memory:"
  },
  "TestEnvironment": {
    "EnableDetailedErrors": true,
    "UseInMemoryDatabase": true,
    "SeedTestData": false,
    "TestTimeoutSeconds": 30
  }
}